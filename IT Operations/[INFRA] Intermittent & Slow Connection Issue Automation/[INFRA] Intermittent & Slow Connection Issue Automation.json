    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const json = item.json;\n  \n  // Get Raw Subject/Summary and Description\n  const rawSummaryInput = json.Subject || json.summary || \"\";\n  const description = json.Description || json.description || \"\";\n\n  // CLEANUP LINE BREAKS & MULTIPLE SPACES IN SUMMARY\n  const rawSummary = rawSummaryInput.replace(/[\\r\\n]+/g, ' ').replace(/\\s+/g, ' ').trim();\n\n  // Clean Summary by removing \"Subject: \" prefix if present\n  const summary = rawSummary.replace(/^Subject:\\s*/i, '').trim();\n\n  // 1. Flexible Date & Time extraction (handles optional seconds like 4/11/2026 10:46 am or 7/20/2026 8:15:42 PM)\n  const dateTimeRegex = /(\\d{1,2}\\/\\d{1,2}\\/\\d{4}\\s+\\d{1,2}:\\d{2}(?::\\d{2})?\\s*(?:AM|PM))/i;\n  const dateTimeMatch = description.match(dateTimeRegex);\n  const dateTime = dateTimeMatch ? dateTimeMatch[1] : \"\";\n\n  // 2. Extract Diagnosis (case-insensitive)\n  const diagnosisRegex = /(Slow Connection|Intermittent)/i;\n  const diagnosisMatch = summary.match(diagnosisRegex);\n  const diagnosis = diagnosisMatch ? diagnosisMatch[1] : \"\";\n\n  // Split summary segments by pipe\n  const parts = summary.split('|').map(p => p.trim());\n\n  // Filter out STATUS tags, date tags (e.g. 04112026), and TEST tags\n  const candidates = parts.filter(part => {\n    const isStatus = /Status:/i.test(part) || diagnosisRegex.test(part);\n    const isDateTag = /^\\d{6,8}$/.test(part);\n    const isTest = /^TEST$/i.test(part);\n    return !isStatus && !isDateTag && !isTest && part.length > 0;\n  });\n\n  let location = \"\";\n  let networkDevice = \"\";\n\n  // Look specifically for candidate containing parentheses e.g. \"SLZ - Imus BC (CICTBC_IMU_AS01)\"\n  const deviceCandidateIndex = candidates.findIndex(c => /\\(.*\\)/.test(c));\n\n  if (deviceCandidateIndex !== -1) {\n    networkDevice = candidates[deviceCandidateIndex];\n    // Remaining candidates before the device candidate form the Location\n    location = candidates.slice(0, deviceCandidateIndex).join(' | ');\n  } else {\n    // Fallback if no candidate contains parentheses\n    if (candidates.length === 1) {\n      location = candidates[0];\n    } else if (candidates.length >= 2) {\n      location = candidates[0];\n      networkDevice = candidates[1];\n    }\n  }\n\n  // 4. Extract Date only\n  const dateOnly = dateTime ? dateTime.split(' ')[0] : \"\";\n\n  // EXTRA SAFETY CLEANUP FOR BOTH SUMMARY & NETWORK DEVICE\n  const cleanSummary = summary.replace(/[\\r\\n]+/g, ' ').replace(/\\s+/g, ' ').trim();\n  const cleanNetworkDevice = networkDevice.replace(/[\\r\\n]+/g, ' ').replace(/\\s+/g, ' ').trim();\n\n  // 5. DETERMINE SUPPORT GROUP\n  let supportGroup = \"IT Technical Unassigned\"; // Default fallback\n\n  if (/\\bCNLZ\\b/i.test(cleanSummary)) {\n    supportGroup = \"IT Technical Central\";\n  } else if (/\\bNLZ\\b/i.test(cleanSummary)) {\n    supportGroup = \"IT Technical North\";\n  } else if (/\\bSLZ\\b/i.test(cleanSummary) || /SOUTH LUZON/i.test(cleanSummary)) {\n    supportGroup = \"IT Technical South\";\n  } else if (/\\bVIZMIN\\b/i.test(cleanSummary)) {\n    supportGroup = \"IT Technical Visayas/Mindanao\";\n  } else if (/\\bNCR\\b/i.test(cleanSummary)) {\n    supportGroup = \"IT Technical NCR\";\n  }\n\n  return {\n    json: {\n      summary: cleanSummary,\n      dateTime: dateTime,\n      diagnosis: diagnosis,\n      location: location,\n      date: dateOnly,\n      networkDevice: cleanNetworkDevice,\n      supportGroup: supportGroup // New field added here\n    }\n  };\n});"
      },
