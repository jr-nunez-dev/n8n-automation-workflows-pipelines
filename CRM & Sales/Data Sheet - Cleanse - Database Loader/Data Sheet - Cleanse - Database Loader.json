    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst row = $json;\n\nconst cleanText = (value) =>\n  value == null ? '' : String(value).trim();\n\nconst rawAge = cleanText(row.age);\nconst rawActive = cleanText(row.active).toLowerCase();\n\nlet age = null;\n\nif (rawAge !== '' && /^\\d+$/.test(rawAge)) {\n  age = Number(rawAge);\n}\n\nlet active = null;\n\nif (['true', 'yes', '1'].includes(rawActive)) {\n  active = true;\n} else if (['false', 'no', '0'].includes(rawActive)) {\n  active = false;\n}\n\nreturn {\n  json: {\n    record_id: cleanText(row.record_id),\n    full_name: cleanText(row.full_name),\n    email: cleanText(row.email).toLowerCase(),\n    department: cleanText(row.department),\n    age,\n    active,\n    created_at: cleanText(row.created_at),\n\n    // Internal tracking fields\n    is_valid: false,\n    rejection_reasons: []\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        -16
      ],
      "id": "2ad08172-1999-445c-ac60-a715c206907f",
      "name": "clean&Normalize"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst row = $json;\nconst errors = [];\n\nconst emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst datePattern = /^\\d{4}-\\d{2}-\\d{2}$/;\n\nfunction isRealDate(value) {\n  if (!datePattern.test(value)) return false;\n\n  const [year, month, day] = value.split('-').map(Number);\n  const date = new Date(Date.UTC(year, month - 1, day));\n\n  return (\n    date.getUTCFullYear() === year &&\n    date.getUTCMonth() === month - 1 &&\n    date.getUTCDate() === day\n  );\n}\n\nif (!row.record_id) {\n  errors.push('Missing record_id');\n}\n\nif (!row.full_name) {\n  errors.push('Missing full_name');\n}\n\nif (!row.email) {\n  errors.push('Missing email');\n} else if (!emailPattern.test(row.email)) {\n  errors.push('Invalid email format');\n}\n\nif (!row.department) {\n  errors.push('Missing department');\n}\n\nif (\n  !Number.isInteger(row.age) ||\n  row.age < 18 ||\n  row.age > 100\n) {\n  errors.push('Age must be an integer between 18 and 100');\n}\n\nif (typeof row.active !== 'boolean') {\n  errors.push('Invalid active value');\n}\n\nif (!isRealDate(row.created_at)) {\n  errors.push('Invalid created_at date; expected YYYY-MM-DD');\n}\n\nreturn {\n  json: {\n    ...row,\n    is_valid: errors.length === 0,\n    rejection_reasons: errors\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        -16
      ],
      "id": "98a837e4-44d7-4a76-9eab-d14108879c07",
      "name": "validateRecords"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst seen = new Set();\n\nreturn items.map((item) => {\n  const row = item.json;\n  const reasons = [...(row.rejection_reasons ?? [])];\n\n  if (row.record_id) {\n    if (seen.has(row.record_id)) {\n      reasons.push('Duplicate record_id within CSV file');\n    } else {\n      seen.add(row.record_id);\n    }\n  }\n\n  return {\n    json: {\n      ...row,\n      is_valid: reasons.length === 0,\n      rejection_reasons: reasons\n    }\n  };\n});\n"
      },
