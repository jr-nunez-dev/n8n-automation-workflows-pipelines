    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst rows = items.map(item => item.json);\n\nconst validRows = rows.filter(row => row.is_valid);\nconst rejectedRows = rows.filter(row => !row.is_valid);\n\nreturn [{\n  json: {\n    status: rejectedRows.length === 0\n      ? 'COMPLETED'\n      : validRows.length === 0\n        ? 'COMPLETED_WITH_REJECTIONS'\n        : 'COMPLETED_WITH_REJECTIONS',\n\n    total_rows: rows.length,\n    valid_rows: validRows.length,\n    rejected_rows: rejectedRows.length,\n    rejection_rate: rows.length === 0\n      ? 0\n      : Number(\n          (rejectedRows.length / rows.length * 100).toFixed(2)\n        ),\n\n    generated_at: new Date().toISOString(),\n\n    rejection_breakdown: rejectedRows.reduce(\n      (counts, row) => {\n        for (const reason of row.rejection_reasons ?? []) {\n          counts[reason] = (counts[reason] ?? 0) + 1;\n        }\n        return counts;\n      },\n      {}\n    )\n  }\n}];\n"
      },
